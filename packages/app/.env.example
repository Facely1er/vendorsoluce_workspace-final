# ============================================
# VendorSoluce Environment Configuration
# ============================================
# SECURITY: This file contains PLACEHOLDERS only - no actual secrets
# Copy this file to .env.local for local development and fill in your actual values
# For production, configure these in your deployment platform (Vercel, etc.)
# ============================================

# ============================================
# REQUIRED - Must be configured for production
# ============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard â†’ Your Project â†’ Settings â†’ API
# âš ï¸ SECURITY: Replace with your actual Supabase credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============================================
# OPTIONAL - Application Configuration
# ============================================

# Application Environment
# Options: development, staging, production
VITE_APP_ENV=development

# Demo Mode - bypasses Supabase auth, auto-logs in as demo user for testing
# Set to true for local demo/testing. NEVER enable in production.
# VITE_DEMO_MODE=true

# Protected routes: local dev server opens them by default (no env needed).
# Set VITE_UNGATE_PROTECTED_ROUTES=false to test sign-in redirects locally.
# Production / preview builds: set VITE_UNGATE_PROTECTED_ROUTES=true only for private QA deploys.
# Shows an amber banner when ungated. NEVER on public production.
# VITE_UNGATE_PROTECTED_ROUTES=false
# VITE_UNGATE_PROTECTED_ROUTES=true

# Application Version
VITE_APP_VERSION=1.0.0

# Application Name
VITE_APP_NAME=VendorSoluce

# Marketing website URL (e.g. for contact/legal links)
# VITE_WEBSITE_URL=https://www.vendorsoluce.com

# TechnoSoluce™ — SBOM funnel from VendorSoluce (Solutions → Supply chain tools, command palette, onboarding).
# Prefer a dedicated SBOM landing path; falls back to VITE_TECHNOSOLUCE_URL when unset.
# VITE_TECHNOSOLUCE_SBOM_URL=https://technosoluce.example/sbom
# VITE_TECHNOSOLUCE_URL=https://technosoluce.example

# Enterprise (on-premise) build download URL. If set, the Downloads page shows a direct download link for the license-based build.
# VITE_ENTERPRISE_DOWNLOAD_URL=https://www.vendorsoluce.com/download

# API Base URL (for backend services)
VITE_API_BASE_URL=https://api.vendorsoluce.com

# ============================================
# OPTIONAL - API Rate Limiting
# ============================================

# Maximum API requests per time window
VITE_API_RATE_LIMIT=100

# API rate limit time window in milliseconds (default: 60000 = 1 minute)
VITE_API_RATE_WINDOW=60000

# ============================================
# OPTIONAL - Feature Flags
# ============================================

# Enable vendor assessments feature
# Options: true, false
VITE_ENABLE_VENDOR_ASSESSMENTS=true

# Enable advanced analytics feature
# Options: true, false
VITE_ENABLE_ADVANCED_ANALYTICS=true

# ============================================
# OPTIONAL - Stripe Payment Integration
# ============================================
# Get these from: https://dashboard.stripe.com â†’ Developers â†’ API Keys
# Use test keys (pk_test_...) for development; use live keys (pk_live_...) for production.
# Publishable key, secret key, and all price IDs must be from the same Stripe account.

# Stripe Publishable Key (Frontend) - required for Checkout. Set in Netlify env vars.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhook Secret (Backend - Supabase Edge Functions only)
# DO NOT use VITE_ prefix -- Vite inlines VITE_* into the client bundle.
# Set as STRIPE_WEBHOOK_SECRET in Supabase Edge Function secrets only.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product Price IDs (Monthly and Annual are distinct SKUs)
# Public USD amounts must match www.vendorsoluce.com/pricing — see src/config/canonical-public-pricing.json
# Run: node scripts/rebuild-stripe-catalog.js or node scripts/verify-stripe-catalog.js
VITE_STRIPE_PRICE_STARTER=price_1TEQimI8FTbdI7aVLrFOu3J6
VITE_STRIPE_PRICE_STARTER_UPDATES=price_1TEQinI8FTbdI7aVpQf5COYd
VITE_STRIPE_LINK_STARTER=https://buy.stripe.com/fZudR9eQWaJc0gqbiD18c0s
VITE_STRIPE_LINK_STARTER_UPDATES=https://buy.stripe.com/cNi7sL8syg3w4wGaez18c0t
VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_1TEQioI8FTbdI7aVnFRuAknP
VITE_STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_1TEQiqI8FTbdI7aVQHYivjCO
VITE_STRIPE_LINK_PROFESSIONAL_MONTHLY=https://buy.stripe.com/5kQ5kDbEK9F88MWeuP18c0u
VITE_STRIPE_LINK_PROFESSIONAL_ANNUAL=https://buy.stripe.com/9B69ATbEKeZs5AKgCX18c0v
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1TEQirI8FTbdI7aVljwHOxRT
VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_1TEQisI8FTbdI7aVS6jT0AzO
VITE_STRIPE_LINK_ENTERPRISE_MONTHLY=https://buy.stripe.com/00wcN524a18CbZ8gCX18c0w
VITE_STRIPE_LINK_ENTERPRISE_ANNUAL=https://buy.stripe.com/8x29AT6kq04y0gq1I318c0x
VITE_STRIPE_PRICE_FEDERAL=

# Stripe Product IDs (Optional)
VITE_STRIPE_PRODUCT_STARTER=prod_UCqPi0gG8rzJnZ
VITE_STRIPE_PRODUCT_PROFESSIONAL=prod_UCqPIXtfCCnyfq
VITE_STRIPE_PRODUCT_ENTERPRISE=prod_UCqPZOHOENhGFL
VITE_STRIPE_PRODUCT_FEDERAL=

# ============================================
# BACKEND ONLY - Supabase Edge Functions
# ============================================
# These are NOT used in the frontend and should be configured as Supabase secrets
# Configure via: supabase secrets set KEY=value
# Or in Supabase Dashboard â†’ Project Settings â†’ Edge Functions â†’ Secrets
# âš ï¸ NEVER set these as frontend environment variables - they are backend-only

# Stripe Secret Key (Backend only - NEVER expose in frontend)
# Get this from: Stripe Dashboard â†’ Developers â†’ API Keys â†’ Secret key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Supabase Service Role Key (Backend only - NEVER expose in frontend)
# Get this from: Supabase Dashboard â†’ Settings â†’ API â†’ service_role key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL for checkout success/cancel redirects (Edge Functions). SUPABASE_ANON_KEY and SUPABASE_URL are auto-injected by Supabase.
# APP_URL=https://www.platform.vendorsoluce.com

# ============================================
# OPTIONAL - Monitoring & Analytics
# ============================================

# Sentry DSN for error tracking
# Get this from: https://sentry.io â†’ Your Project â†’ Settings â†’ Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Google Analytics Measurement ID
# Get this from: https://analytics.google.com â†’ Admin â†’ Data Streams
# Format: G-XXXXXXXXXX or UA-XXXXXXXXX-X
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# License verification (offline RS256)
# ============================================
# Copy full contents of ermits-license-public.pem
# VITE_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----"

# Demo license keys (dev only)
# VITE_ALLOW_DEMO_LICENSE=true
