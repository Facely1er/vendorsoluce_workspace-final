{
  "name": "vendor-risk-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vendor Risk Portal \u2013 standalone React app for vendor assessments. Integrates with the platform (App) or runs standalone in customer environment.",
  "scripts": {
    "dev": "node ./scripts/run-vite.mjs",
    "build": "npm run verify:integration && node ./scripts/run-vite.mjs build",
    "preview": "node ./scripts/run-vite.mjs preview",
    "type-check": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "verify:integration": "node scripts/verify-portal-integration.mjs"
  },
  "dependencies": {
    "shared": "file:../shared",
    "@supabase/supabase-js": "^2.52.1",
    "@vercel/analytics": "^1.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^7.2.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.295.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.7",
    "@sentry/react": "^10.17.0",
    "@ermits/dependency-graph": "file:../dependency-graph"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.4"
  }
}
