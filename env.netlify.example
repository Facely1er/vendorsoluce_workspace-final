# Netlify Environment Variables — Platform App (www.platform.vendorsoluce.com)
# To import: Copy this file to env.netlify, fill in your values, then run:
#   netlify env:import env.netlify
# Or in Netlify UI: Site configuration → Environment variables → Import from .env
# Only VITE_* variables are embedded into the build.
#
# Note: RESEND_API_KEY and EMAIL_FROM are for the contact-form Edge Function.
# Set those in Supabase Dashboard → Edge Functions → contact-form → Secrets,
# not in Netlify. See SUPABASE_CONTACT_SETUP.md for details.
#
# REMOVED from Netlify env vars (no longer referenced in client bundle):
#   VITE_STRIPE_WEBHOOK_SECRET — server-only secret; set in Supabase Edge Function secrets only
#   VITE_STRIPE_LINK_ENTERPRISE — value covered by VITE_STRIPE_LINK_ENTERPRISE_MONTHLY
#   VITE_STRIPE_LINK_FEDERAL — Federal is contact-sales only; no client-side payment link

# Required (ERMITS shared project ref: dfklqsdfycwjlcasfciu)
VITE_SUPABASE_URL=https://dfklqsdfycwjlcasfciu.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Application
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=VendorSoluce
VITE_API_BASE_URL=https://api.vendorsoluce.com

# Stripe Price IDs & Payment Links (from rebuild-stripe-catalog.js)
VITE_STRIPE_PRICE_STARTER=
VITE_STRIPE_PRICE_STARTER_UPDATES=
VITE_STRIPE_LINK_STARTER=
VITE_STRIPE_LINK_STARTER_UPDATES=
VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=
VITE_STRIPE_PRICE_PROFESSIONAL_ANNUAL=
VITE_STRIPE_LINK_PROFESSIONAL_MONTHLY=
VITE_STRIPE_LINK_PROFESSIONAL_ANNUAL=
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=
VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=
VITE_STRIPE_LINK_ENTERPRISE_MONTHLY=
VITE_STRIPE_LINK_ENTERPRISE_ANNUAL=
VITE_STRIPE_PRICE_FEDERAL=
